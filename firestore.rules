rules_version = '2';

// 별도 로그인 없이 "참여코드"만으로 학교 데이터에 접근하는 구조.
// schoolId(무작위 문서 ID)와 참여코드를 모르면 어떤 데이터에도 접근할 수 없고,
// 컬렉션 전체를 나열(list)하는 것은 막아 다른 학교 목록을 훑어볼 수 없게 한다.
service cloud.firestore {
  match /databases/{database}/documents {

    // code -> schoolId 조회 (참여코드를 이미 아는 사람만 의미 있게 사용 가능)
    match /inviteCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if true; // 학교를 새로 만들 때 함께 생성
      allow update, delete: if false;
    }

    // 학교 워크스페이스: schoolId를 아는 사람만 개별 조회 가능, 전체 나열은 불가
    match /schools/{schoolId} {
      allow get: if true;
      allow list: if false;
      allow create: if true;
      allow update: if true;
      allow delete: if false;

      match /events/{id} {
        allow read, write: if true;
      }
      match /duties/{id} {
        allow read, write: if true;
      }
      match /docs/{id} {
        allow read, write: if true;
      }
      match /notices/{id} {
        allow read, write: if true;
      }
    }
  }
}
