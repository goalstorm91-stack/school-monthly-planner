rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function mySchoolId() {
      return myProfile().schoolId;
    }

    function isSchoolAdmin(schoolId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/schools/$(schoolId)).data.adminUids;
    }

    function inSchool(schoolId) {
      return signedIn() && mySchoolId() == schoolId;
    }

    // ---- user profile: schoolId, role, displayName, email ----
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ---- invite code -> schoolId lookup (created together with a school) ----
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ---- school workspace ----
    match /schools/{schoolId} {
      allow create: if signedIn()
        && request.resource.data.adminUids is list
        && request.auth.uid in request.resource.data.adminUids;
      allow read: if inSchool(schoolId);
      allow update: if inSchool(schoolId) && isSchoolAdmin(schoolId);
      allow delete: if false;

      match /events/{id} {
        allow read: if inSchool(schoolId);
        allow create: if inSchool(schoolId) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if inSchool(schoolId)
          && (resource.data.createdBy == request.auth.uid || isSchoolAdmin(schoolId));
      }

      match /duties/{id} {
        allow read: if inSchool(schoolId);
        allow create: if inSchool(schoolId) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if inSchool(schoolId)
          && (resource.data.createdBy == request.auth.uid || isSchoolAdmin(schoolId));
      }

      match /docs/{id} {
        allow read: if inSchool(schoolId);
        allow create: if inSchool(schoolId) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if inSchool(schoolId)
          && (resource.data.createdBy == request.auth.uid || isSchoolAdmin(schoolId));
      }
    }
  }
}
